# Copy to .env and fill in. All settings use the JANUS_ prefix (see janus/app/config.py).
# Never commit the real .env.

# --- Infrastructure ---
JANUS_DATABASE_URL=postgresql+asyncpg://janus:janus@localhost:5432/janus
JANUS_LOG_LEVEL=INFO

# --- Sandbox (defaults live in janus.toml; env overrides the file) ---
# Point at another TOML config file instead of janus.toml / pyproject.toml [tool.janus].
# JANUS_CONFIG_FILE=./janus.toml
# Nested keys use a double underscore: JANUS_SANDBOX__IMAGE, JANUS_SANDBOX__MEMORY_MB, ...
# JANUS_SANDBOX__IMAGE_SOURCE=auto
# JANUS_SANDBOX__BASE_IMAGE=python:3.12-slim
# JANUS_SANDBOX__IMAGE=python:3.12-slim
# JANUS_SANDBOX__DOCKER_HOST=unix:///run/user/1000/docker.sock
# JANUS_SANDBOX__REQUIRE_ROOTLESS=true
# JANUS_SANDBOX__ALLOW_HOSTS='["pypi.org", ".github.com"]'
# JANUS_SANDBOX__NETWORK=false

# --- Job processor ---
# Which processor the worker runs: "stub" (default, no-op) or "sandbox" (real work in a container).
# JANUS_PROCESSOR_MODE=sandbox

# --- GitHub App (populated by the manifest flow in S0; see docs/specs/S0.md) ---
# Public base URL for the manifest redirect/webhook; set to your tunnel URL.
# JANUS_PUBLIC_URL=https://your-tunnel.example
JANUS_GITHUB_APP_NAME=Janus
JANUS_GITHUB_APP_ID=
JANUS_GITHUB_PRIVATE_KEY_PATH=
JANUS_GITHUB_WEBHOOK_SECRET=
JANUS_GITHUB_CLIENT_ID=
JANUS_GITHUB_CLIENT_SECRET=
